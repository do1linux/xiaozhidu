# ===== 服务 =====
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8100
BRIDGE_DEBUG=false
# 路径说明：裸 Python / Windows 模式自动定位到代码包内的 prompts/ 与 logs/，
# 不再使用 /app/... 容器路径。确需改位置才用下面三项覆盖（填绝对路径）。
# LOG_DIR=
# NATIVE_KEYWORDS_FILE=
# SYSTEM_PROMPT_FILE=
LOG_TEXT=false          # 默认不落用户语音与回答正文；逐句排障时才开，用完改回 false

# 适配器链：从左到右尝试，前一个挂了自动降级
#   xiaozhi_ws   = 伪装设备连 xiaozhi 的 WebSocket（能用上 xiaozhi 的 MCP/记忆）
#   xiaozhi_http = 你的 xiaozhi 版本若已加 /internal/text_chat 文本接口
#   agnes        = 直连 agnes-ai（兜底，没有 MCP 能力；newapi 为其兼容别名）
ADAPTER_CHAIN=xiaozhi_ws,agnes

# ===== xiaozhi-esp32-server =====
XIAOZHI_WS_URL=ws://127.0.0.1:8000/xiaozhi/v1/
XIAOZHI_DEVICE_ID=voice-bridge-01
XIAOZHI_CLIENT_ID=voice-bridge
XIAOZHI_TOKEN=
XIAOZHI_WS_TIMEOUT=40
# 纯文本注入帧（不同版本支持方式不同，改这里即可，不必改代码）
XIAOZHI_TEXT_FRAME={"session_id":"{session_id}","type":"listen","state":"detect","text":"{text}"}

# 若走 xiaozhi_http 适配器
XIAOZHI_HTTP_URL=http://127.0.0.1:8000/internal/text_chat

# ===== agnes-ai（OpenAI 兼容大模型，直连兜底）=====
# 想最少依赖先跑通：把 ADAPTER_CHAIN 改成 agnes，只走这条路，不装 xiaozhi 服务端
AGNES_BASE=https://apihub.agnes-ai.com/v1
AGNES_KEY=sk-在这里填agnes-ai密钥
# 默认 agnes-3.0-flash（非推理，约 2s，稳定返回 JSON）
# 别填 agnes-2.5-flash / 2.5-pro 等推理模型：只吐 reasoning_content、content 为空
AGNES_MODEL=agnes-3.0-flash
AGNES_TIMEOUT=30
AGNES_JSON_MODE=true
# 兼容旧部署：以上变量留空时会回退读取 NEWAPI_BASE / NEWAPI_KEY / NEWAPI_MODEL

# ===== 意图判定 =====
NATIVE_FASTPATH=true       # 设备控制类走规则，不烧 token、零延迟
QUESTION_GUARD=true        # 疑问句强制走问答，避免"该答不答"
# NATIVE_KEYWORDS_FILE 见文件头「路径说明」，默认自动定位
MAX_TTS_CHARS=300
# 护栏顶掉误判却仍拿不到答案时的兜底话术
FALLBACK_REPLY=这个问题我一时没查到准确的，等我确认一下再告诉你。
MIN_QUERY_LEN=2
HISTORY_TURNS=0            # >0 开启多轮记忆（会占用上下文，按需开）

# ===== 可选运行参数（代码读取，未填写时用默认值）=====
# BRIDGE_ROOT=/app                 # Docker 内项目根目录，本地运行一般不用填
# BRIDGE_DOTENV=.env               # 显式指定 .env 路径，默认自动定位
# MI_TOKEN_PATH=~/.mi.token        # 小米登录态缓存文件，默认用户主目录
# RECENT_BUFFER=50                 # 近期对话缓冲条数，默认 50
# XIAOGPT_CONFIG=config/xiaogpt.yaml  # xiaogpt 兼容配置路径（bot 侧）
