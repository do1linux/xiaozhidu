# ===== 小爱账号（miservice 登录用，必填）=====
hardware: LX06          # 音箱型号，底部标签可见；不确定就填 LX06
account: "<小米账号>"    # 小米账号
password: "<小米密码>"
# 二选一：填 cookie 可跳过账号密码（见 README「登录排障」）
cookie: ""
mi_did: ""              # 留空自动探测；多台音箱时建议填 MIoT DID

# ===== 播报方式（小爱账号侧，本链路不直接使用，保留兼容） =====
tts: mi                 # mi = 小爱自带 TTS；也可 edge/openai（音色更好但更慢）
use_command: false      # 老设备 TTS 走 miIO 指令时才需要 true
verbose: false

# ===== 播报出口（本链路真正读取） =====
#   mi   = 小爱音箱原声（默认）。声音从小爱出，音色不可自定义。
#   edge = PC 本地 edge-tts 播报。声音从电脑声卡出，可选台湾腔等音色；
#          小爱仍负责唤醒/听写/原生指令，只是不再念大模型的回答。
#          需在本机安装 bot/requirements.txt（含 edge-tts），且需联网。
tts_backend: mi
tts_voice: zh-TW-HsiaoChenNeural   # edge 音色：台湾腔女声（晓臻）
                                    # 其他可选：zh-TW-HsiaoYuNeural / zh-TW-YunJheNeural(男)
tts_rate: "+0%"                     # 语速，如 +10% / -10%
tts_volume: "+0%"                   # 音量
tts_pitch: "+0Hz"                   # 音调

# ===== 桥接参数（本文件由 bot/xiaoai_bot.py 读取）=====
bot_options:
  bridge_url: "http://127.0.0.1:8100/api/text_chat"
  bridge_timeout: 45          # 单句总超时，含 LLM 推理 + MCP 调用
  mute_before_tts: true       # 播报前先让小爱停止（它刚可能回了"没找到"）
  pre_tts_delay: 0.6          # 留一点尾音时间，避免两路声音打架
  tts_chunk: 80               # 单次 TTS 字数上限
  tts_char_delay_ms: 190      # 每字朗读耗时（毫秒），段间等待 = 字数 × 此值
  min_query_len: 2            # 短于此长度的识别结果直接忽略（"嗯""啊"）
  startup_ping: true
  skip_queries:
    - "开始持续对话"
    - "结束持续对话"
    - "小爱同学"
